{
    "name": "Python & Dagger Template",
    "image": "mcr.microsoft.com/devcontainers/python:3.14",
    // If a mounted data folder is needed, uncomment the following lines.
    // "mounts": [
    //     "source=${localEnv:HOME}/devdata,target=/devdata,type=bind,consistency=delegated"
    // ],
    // If Claude Code's login session/settings/memory should survive a container rebuild, uncomment the following lines.
    // "mounts": [
    //     "source=claude-code-config,target=/home/vscode/.claude,type=volume"
    // ],
    "features": {
        "python": "3.14"
        // If Docker is needed (for local Dagger), uncomment the following line.
        // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "remoteEnv": {
        "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
    },
    "postCreateCommand": "bash scripts/devcontainer-setup.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "ms-python.pylint",
                "nwgh.bandit",
                "ms-python.black-formatter",
                "foxundermoon.shell-format",
                "njpwerner.autodocstring",
                "wayou.vscode-todo-highlight",
                "hediet.vscode-drawio",
                "bierner.markdown-mermaid"
            ]
        }
    }
}